# User data: profile, database, templates, applications, settings (API key).
/data/*
!/data/.gitignore

# A demo workspace built by scripts/seed_demo.py. It holds settings.json too, and
# therefore the API key pasted into it: it must never be committed.
/demo-data/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage (pytest-cov), from a local run or a ``--cov-report``.
.coverage
.coverage.*
coverage.xml
htmlcov/

# Docker / OS
.DS_Store
